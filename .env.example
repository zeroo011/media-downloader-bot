# ==============================================================================
# КОНФИГУРАЦИЯ TELEGRAM-БОТА СКАЧИВАНИЯ МЕДИА
# Скопируйте этот файл в .env и укажите ваши параметры:
#   cp .env.example .env
# ==============================================================================

# [ОБЯЗАТЕЛЬНО] Токен бота от @BotFather (формат: 123456789:ABCDefgh...)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ1234567890

# [ОБЯЗАТЕЛЬНО] Числовой Telegram ID главного администратора
# (можно узнать в боте @userinfobot)
ADMIN_ID=123456789

# Юзернейм бота (без @) — если оставить пустым, определится автоматически
BOT_USERNAME=

# Публичный URL веб-сервера для раздачи файлов > 49 МБ и инлайн-превью
# Например: https://media.yourdomain.com или http://YOUR_SERVER_IP:8080
# Оставьте пустым, если веб-сервер не проксируется через домен
WEB_BASE_URL=http://YOUR_SERVER_IP:8080

# Порт встроенного aiohttp веб-сервера (по умолчанию: 8080)
WEB_PORT=8080

# Каталог для базы данных SQLite и кэша файлов (по умолчанию: ./data)
DATA_DIR=./data

# ==============================================================================
# НАСТРОЙКИ ПРОИЗВОДИТЕЛЬНОСТИ И ЛИМИТОВ (АВТОМАТИЧЕСКИ РАСЧИТЫВАЮТСЯ В install.sh)
# ==============================================================================

# Количество параллельных воркеров скачивания (Low: 1, Medium: 2, High: 4)
NUM_WORKERS=2

# Количество потоков FFmpeg при конвертации видео и звука (Low: 1, Medium: 2, High: 4)
FFMPEG_THREADS=1

# Максимальный размер файла для веб-скачивания в мегабайтах (по умолчанию: 250)
MAX_FILE_SIZE_MB=250

# Время жизни временных веб-ссылок на сервере в секундах (по умолчанию: 420 сек / 7 мин)
WEB_TTL_SECONDS=420

# Время жизни кэша для кнопок быстрого извлечения MP3/Кружочка (240 сек / 4 мин)
CACHE_TTL_SECONDS=240

# Квота диска под веб-загрузки в гигабайтах (по умолчанию: 3.5 ГБ)
MAX_WEB_DIR_GB=3.5

# Квота диска под кэш быстрых кнопок в гигабайтах (по умолчанию: 1.0 ГБ)
MAX_CACHE_DIR_GB=1.0

# Минимальный гарантированный запас свободного места на диске в ГБ (по умолчанию: 2.0 ГБ)
MIN_FREE_DISK_GB=2.0
